# Copier vers .env si besoin. Docker Compose, les scripts npm de laboratoire (setup, start, reset, lab:*), `npm run dev` et la
# recette lisent .env (sans écraser les variables déjà exportées dans votre shell).
# Aucun secret réel dans ce fichier. Services liés à 127.0.0.1 : laboratoire local uniquement.
# --- Commandes (order-service) ---
PORT=3000
HOST=127.0.0.1
# Backend de /availability : http (historique TP2, défaut) ou grpc (après complétion du TP3)
STOCK_BACKEND=http
STOCK_BASE_URL=http://127.0.0.1:3001
STOCK_GRPC_TARGET=127.0.0.1:50051
STOCK_GRPC_DEADLINE_MS=500
# SESSION_SECRET=  (optionnel : secret de signature du cookie démo ; aléatoire à chaque démarrage si absent)
# LAB_MODE=1       (Commandes : failpoint T7 + POST /api/lab/reset-orders ; « npm run start » et « npm run dev » l'activent. Refusé en production.)
# --- Stocks HTTP (stock-service) ---
STOCK_PORT=3001
STOCK_HOST=127.0.0.1
STOCK_LATENCY_MS=50
STOCK_MODE=normal
STOCK_AVAILABLE=12
# --- Stocks gRPC (même processus que Stocks HTTP) ---
GRPC_STOCK_HOST=127.0.0.1
GRPC_STOCK_PORT=50051
GRPC_STOCK_LATENCY_MS=50
# --- RabbitMQ (AMQP 5672, interface Management 15672) ---
# Identifiants FACTICES de laboratoire : refusés par les applications si NODE_ENV=production.
# Ports hôte configurables : changez-les si un autre RabbitMQ/PostgreSQL (ex. celui du TP4) occupe déjà ces ports.
RABBITMQ_USER=lab
RABBITMQ_PASSWORD=lab-only-change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
# RABBITMQ_URL=amqp://lab:lab-only-change-me@127.0.0.1:5672   (optionnel : remplace l'URL construite ci-dessus)
# --- PostgreSQL local (port hôte 55432 : évite un PostgreSQL déjà présent sur 5432) ---
# Les scripts de remise à zéro refusent toute base dont le nom ne se termine pas par _lab ou dont l'hôte n'est pas local.
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab-only-change-me
POSTGRES_DB=infal73_tp5_lab
POSTGRES_PORT=55432
# DATABASE_URL=postgres://lab:lab-only-change-me@127.0.0.1:55432/infal73_tp5_lab   (optionnel)
# --- Workers et laboratoire ---
# WORKER_NAME=statistics-b                  (nom d'instance dans les logs ; une 2e instance d'une MÊME queue partage les livraisons)
# FAULT=EXIT_AFTER_COMMIT_BEFORE_ACK        (TP4, laboratoire local uniquement : interdit si NODE_ENV=production)
# LAB_STATE_DIR=.lab-state                  (état des injections de panne, failpoint, journal d'audit, pids/logs de « npm run start »)
# DEV_WORKER=0                              (npm run dev ne lance pas le worker de préparation TP4)
# DEV_EVENTS=0                              (npm run dev ne lance pas les consommateurs d'événements TP5)
