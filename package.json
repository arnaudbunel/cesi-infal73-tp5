{
  "name": "infal73-tp5-student",
  "version": "1.0.0",
  "private": true,
  "description": "TP INFAL73 - Partie 6 : intégration événementielle du fil rouge (RabbitMQ topic, consommateurs idempotents, PostgreSQL). Socle étudiant.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/contracts",
    "packages/messaging",
    "apps/order-service",
    "apps/stock-service",
    "apps/preparation-worker",
    "apps/event-workers"
  ],
  "scripts": {
    "postinstall": "npm run build -w packages/contracts -w packages/messaging",
    "predev": "npm run build -w packages/contracts -w packages/messaging",
    "dev": "node scripts/dev.mjs",
    "dev:orders": "npm run dev -w apps/order-service",
    "dev:stocks": "npm run dev -w apps/stock-service",
    "dev:worker": "npm run dev -w apps/preparation-worker",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:destroy": "node scripts/infra.mjs destroy",
    "infra:status": "node scripts/infra.mjs status",
    "infra:topology": "node scripts/topology.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "lab:state": "node scripts/lab/state.mjs",
    "lab:dependency-down": "node scripts/lab/dependency-down.mjs",
    "lab:invalid-json": "node scripts/lab/inject-invalid-json.mjs",
    "lab:duplicates": "node scripts/lab/publish-duplicates.mjs",
    "lab:broker": "node scripts/lab/broker.mjs",
    "reset": "node scripts/reset.mjs",
    "build": "npm run build --workspaces",
    "pretypecheck": "npm run build -w packages/contracts -w packages/messaging",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w packages/contracts -w packages/messaging",
    "test": "tsx --test --test-concurrency=1 \"tests/smoke/*.test.ts\"",
    "pretest:acceptance": "npm run build -w packages/contracts -w packages/messaging",
    "test:acceptance": "tsx tests/acceptance/tp5/run.ts",
    "test:acceptance:tp3": "tsx --test --test-concurrency=1 \"tests/acceptance/tp3-*.test.ts\" \"tests/acceptance/availability-contract.test.ts\"",
    "test:acceptance:tp4": "tsx --test --test-concurrency=1 \"tests/acceptance/tp4-*.test.ts\"",
    "test:unit": "tsx --test \"tests/smoke/*.test.ts\"",
    "setup": "node scripts/infra.mjs up",
    "start": "node scripts/stack.mjs start",
    "stop": "node scripts/stack.mjs stop",
    "status": "node scripts/stack.mjs status",
    "logs": "node scripts/stack.mjs logs",
    "dev:notifications": "npm run dev -w apps/event-workers -- notifications",
    "dev:statistics": "npm run dev -w apps/event-workers -- statistics",
    "dev:audit": "npm run dev -w apps/event-workers -- audit",
    "worker:stop": "node scripts/lab/worker.mjs stop",
    "worker:start": "node scripts/lab/worker.mjs start",
    "lab:event": "node scripts/lab/publish-event.mjs",
    "lab:statistics-fail": "node scripts/lab/statistics-fail.mjs",
    "lab:failpoint": "node scripts/lab/failpoint.mjs",
    "lab:routing-check": "node scripts/lab/routing-check.mjs",
    "smoke": "npm run test",
    "test:regression": "npm run test && npm run test:acceptance:tp3 && npm run test:acceptance:tp4",
    "test:acceptance:tp5": "npm run test:acceptance",
    "test:acceptance:tp5:strict": "tsx tests/acceptance/tp5/run.ts --strict",
    "pretest:acceptance:tp3": "npm run build -w packages/contracts -w packages/messaging",
    "pretest:acceptance:tp4": "npm run build -w packages/contracts -w packages/messaging"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "@types/ws": "^8.18.2",
    "ws": "^8.22.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
